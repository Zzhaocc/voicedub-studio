# ===== 运行环境 =====
# development / staging / production，仅用于标注与日志，不改变业务逻辑
APP_ENV=development
DEBUG=false

# ===== 存储 =====
# 一个根目录派生：库文件、uploads/、media/、work/ 都在它下面
# 容器里只需挂这一个卷
VOICEDUB_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/studio.db
# 换 PostgreSQL：pip install "psycopg[binary]"
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/voicedub

# ===== 媒体 =====
# ffmpeg / ffprobe 可执行路径（不在 PATH 里时填绝对路径）
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 单条 ffmpeg 命令的超时（秒），防止异常输入把 worker 卡死
VOICEDUB_FFMPEG_TIMEOUT=300
VOICEDUB_SAMPLE_RATE=24000
# 对白句间静音 / 有声书章间静音（秒）
VOICEDUB_SEGMENT_GAP=0.25
VOICEDUB_CHAPTER_GAP=0.8

# ===== 任务队列 =====
# 单 worker 顺序执行：避免多个 ffmpeg 抢 CPU
VOICEDUB_MAX_WORKERS=1

# ===== 接入与可观测 =====
# 允许的跨域来源，逗号分隔；* 仅供本地开发
CORS_ORIGINS=*
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：text（本地阅读）/ json（采集到 Loki、ELK、CloudWatch）
LOG_FORMAT=text
# 请求关联 ID 的响应头名
REQUEST_ID_HEADER=X-Request-ID
# 是否暴露 /docs、/redoc、/openapi.json（生产建议关闭）
DOCS_ENABLED=true
